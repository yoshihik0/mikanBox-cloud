{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikanbox-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mikanbox-cloud",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  // Local development (`npm run dev`): the admin screen and previews. The public site is always
  // a Worker of its own, so these names only describe the arrangement; nothing is published locally.
  "vars": {
    "SITE_ENVIRONMENT": "local",
    "CLOUDFLARE_WORKER_NAME": "mikanbox-cloud",
    "CLOUDFLARE_PUBLIC_WORKER_NAME": "mikanbox-cloud-public",
    "PUBLIC_SITE_URL": "http://localhost:8788"
  }
}
