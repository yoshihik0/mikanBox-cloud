{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikanbox-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mikanbox-cloud",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mikanbox-cloud-media" }]
}
