{
  "name": "mikanbox-cloud",
  "version": "0.6.1",
  "private": true,
  "scripts": {
    "precheck": "node scripts/sync-cloud-help.mjs",
    "pretest": "node scripts/sync-cloud-help.mjs",
    "prebuild": "node scripts/sync-cloud-help.mjs",
    "dev": "wrangler dev",
    "check": "tsc --noEmit && node scripts/verify-protected.mjs",
    "test": "tsc --module Node16 --moduleResolution Node16 --outDir .test-build && node --test tests/*.test.cjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "build": "wrangler deploy --dry-run --outdir .build",
    "prepare:local": "node scripts/prepare-local.mjs",
    "sync:assets": "node scripts/sync-assets.mjs",
    "sync:defaults": "node scripts/sync-defaults.mjs",
    "publish:static": "npm run check && npm run test && node scripts/publish-static.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
