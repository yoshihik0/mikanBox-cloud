{
  "name": "mikanbox-cloud",
  "version": "0.21.5",
  "private": true,
  "scripts": {
    "precheck": "node scripts/sync-admin-ui.mjs",
    "pretest": "node scripts/sync-admin-ui.mjs",
    "prebuild": "node scripts/sync-admin-ui.mjs",
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "tsc --module Node16 --moduleResolution Node16 --outDir .test-build && node --test tests/*.test.cjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "package:update": "node scripts/package-update.mjs",
    "build": "wrangler deploy --dry-run --outdir .build",
    "prepare:local": "node scripts/prepare-local.mjs",
    "sync:assets": "node scripts/sync-assets.mjs",
    "sync:defaults": "node scripts/sync-defaults.mjs",
    "deploy:cloud": "node scripts/deploy-cloud.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  }
}
