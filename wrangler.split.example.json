{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikanbox-split",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SITE_ENVIRONMENT": "staging",
    "CLOUDFLARE_WORKER_NAME": "mikanbox-split",
    "CLOUDFLARE_PUBLIC_WORKER_NAME": "mikanbox-split-public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikanbox-split",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
