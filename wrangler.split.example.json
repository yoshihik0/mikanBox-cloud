{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikanbox-admin",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "SITE_ENVIRONMENT": "staging",
    "CLOUDFLARE_ACCOUNT_ID": "YOUR_CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_D1_ID": "YOUR_D1_DATABASE_ID",
    "CLOUDFLARE_WORKER_NAME": "mikanbox-admin",
    "CLOUDFLARE_PUBLIC_WORKER_NAME": "mikanbox-public",
    "PUBLIC_SITE_URL": "https://mikanbox-public.YOUR_SUBDOMAIN.workers.dev"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "mikanbox-cloud", "database_id": "YOUR_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "observability": { "enabled": false }
}
